  "_gradesComment": "Adjectival grades rather than the numeric Sheldon 1–70 scale — these are what a collector actually says out loud, and they don't imply a precision nobody has measured.",
  "grades": [
    { "id": "poor", "label": "Poor", "short": "P" },
    { "id": "fair", "label": "Fair", "short": "Fr" },
    { "id": "good", "label": "Good", "short": "G" },
    { "id": "very-good", "label": "Very Good", "short": "VG" },
    { "id": "fine", "label": "Fine", "short": "F" },
    { "id": "very-fine", "label": "Very Fine", "short": "VF" },
    { "id": "extremely-fine", "label": "Extremely Fine", "short": "XF" },
    { "id": "about-uncirculated", "label": "About Uncirculated", "short": "AU" },
    { "id": "uncirculated", "label": "Uncirculated", "short": "UNC" },
    { "id": "proof", "label": "Proof", "short": "PF" }
  ],

  "types": [
    { "id": "circulation", "label": "Circulation" },
    { "id": "commemorative", "label": "Commemorative" },
    { "id": "proof", "label": "Proof" },
    { "id": "pattern", "label": "Pattern" },
    { "id": "token", "label": "Token" },
    { "id": "bullion", "label": "Bullion" }
  ],

  "dieAxes": [
    { "id": "medallic", "label": "Medallic (↑↑)", "note": "Flip the coin top-to-bottom and the reverse is upright." },
    { "id": "coin", "label": "Coin (↑↓)", "note": "Flip the coin left-to-right and the reverse is upright." }
  ],

  "_fieldsComment": "Drives the read-only spec table order and the '+ Add detail' menu in edit mode. 'group' clusters rows under a heading; 'vocab' names the list above that supplies options; 'type' tells edit mode which control to render.",
  "fields": [
    { "key": "era",          "label": "Era",          "group": "identity", "type": "select", "vocab": "eras" },
    { "key": "ruler",        "label": "Ruler",        "group": "identity", "type": "select", "vocab": "rulers", "onlyEra": ["east-india-company", "british-india"] },
    { "key": "denomination", "label": "Denomination", "group": "identity", "type": "denomination" },
    { "key": "yearOnCoin",   "label": "Year on coin", "group": "identity", "type": "year" },
    { "key": "yearIssued",   "label": "Year issued",  "group": "identity", "type": "year" },
    { "key": "type",         "label": "Type",         "group": "identity", "type": "select", "vocab": "types" },
    { "key": "series",       "label": "Series",       "group": "identity", "type": "text" },

    { "key": "mint",         "label": "Mint",         "group": "minting", "type": "select", "vocab": "mints" },
    { "key": "mintMark",     "label": "Mint mark",    "group": "minting", "type": "mintmark" },
    { "key": "mintage",      "label": "Mintage",      "group": "minting", "type": "number", "format": "integer" },
    { "key": "dieAxis",      "label": "Die axis",     "group": "minting", "type": "select", "vocab": "dieAxes" },

    { "key": "metal",        "label": "Metal",        "group": "physical", "type": "select", "vocab": "metals" },
    { "key": "fineness",     "label": "Fineness",     "group": "physical", "type": "number", "format": "fineness" },
    { "key": "weight_g",     "label": "Weight",       "group": "physical", "type": "number", "unit": "g" },
    { "key": "diameter_mm",  "label": "Diameter",     "group": "physical", "type": "number", "unit": "mm" },
    { "key": "thickness_mm", "label": "Thickness",    "group": "physical", "type": "number", "unit": "mm" },
    { "key": "shape",        "label": "Shape",        "group": "physical", "type": "select", "vocab": "shapes" },
    { "key": "edge",         "label": "Edge",         "group": "physical", "type": "select", "vocab": "edges" },

    { "key": "grade",        "label": "Grade",        "group": "catalogue", "type": "select", "vocab": "grades" },
    { "key": "km",           "label": "Catalogue ref", "group": "catalogue", "type": "text", "placeholder": "KM# 557" },
    { "key": "acquired",     "label": "Acquired",     "group": "catalogue", "type": "text" }
  ],

  "groups": [
    { "id": "identity",  "label": "Identity" },
    { "id": "minting",   "label": "Minting" },
    { "id": "physical",  "label": "Physical" },
    { "id": "catalogue", "label": "Catalogue" }
  ]
}
