{
  "_comment": "Vocabularies for the coin catalogue. This is data, not code — add a row when a coin turns up that doesn't fit. Every id here is what gets written into coins.json; every label is what the site displays.",

  "eras": [
    { "id": "east-india-company", "label": "East India Company", "years": "1835–1858" },
    { "id": "british-india", "label": "British India", "years": "1858–1947" },
    { "id": "princely-state", "label": "Princely State", "years": "pre-1948" },
    { "id": "republic-india", "label": "Republic India", "years": "1950–present" }
  ],

  "rulers": [
    { "id": "eic", "label": "East India Company", "era": "east-india-company", "from": 1835, "to": 1858 },
    { "id": "victoria-queen", "label": "Victoria, Queen", "era": "british-india", "from": 1862, "to": 1876 },
    { "id": "victoria-empress", "label": "Victoria, Empress", "era": "british-india", "from": 1877, "to": 1901,
      "note": "Victoria took the title Empress of India in 1877 — the legend changes from QUEEN to EMPRESS, which dates the coin precisely." },
    { "id": "edward-vii", "label": "Edward VII", "era": "british-india", "from": 1902, "to": 1910 },
    { "id": "george-v", "label": "George V", "era": "british-india", "from": 1911, "to": 1936 },
    { "id": "george-vi", "label": "George VI", "era": "british-india", "from": 1938, "to": 1947 }
  ],

  "mints": [
    { "id": "calcutta", "label": "Calcutta", "era": ["east-india-company", "british-india"], "note": "The oldest mint — carries no mint mark." },
    { "id": "bombay", "label": "Bombay", "era": ["east-india-company", "british-india"] },
    { "id": "madras", "label": "Madras", "era": ["east-india-company", "british-india"], "note": "Established 1640, closed 1869." },
    { "id": "lahore", "label": "Lahore", "era": ["british-india"], "note": "Opened to add wartime capacity; first coins 1943." },
    { "id": "pretoria", "label": "Pretoria", "era": ["british-india"], "note": "South African mint, struck Indian coins during the Second World War." },
    { "id": "birmingham", "label": "Birmingham (Heaton)", "era": ["british-india", "republic-india"] },
    { "id": "kings-norton", "label": "King's Norton", "era": ["british-india"] },
    { "id": "kolkata", "label": "Kolkata", "era": ["republic-india"], "note": "Successor to the Calcutta mint — still carries no mint mark." },
    { "id": "mumbai", "label": "Mumbai", "era": ["republic-india"] },
    { "id": "hyderabad", "label": "Hyderabad", "era": ["republic-india"] },
    { "id": "noida", "label": "Noida", "era": ["republic-india"], "note": "Established 1984." }
  ],

  "_mintMarksComment": "The picker shows these glyphs so a coin can be identified by looking at it rather than by knowing which city a star means. Order matters — this is the display order.",
  "mintMarks": [
    { "id": "none", "glyph": "—", "label": "No mark", "mints": ["calcutta", "kolkata"] },
    { "id": "diamond", "glyph": "◆", "label": "Diamond", "mints": ["bombay", "mumbai"] },
    { "id": "star", "glyph": "★", "label": "Star", "mints": ["hyderabad", "madras"],
      "note": "Hyderabad on Republic coins; Madras on pre-1869 issues — the date tells them apart." },
    { "id": "dot", "glyph": "•", "label": "Dot", "mints": ["noida", "pretoria"],
      "note": "Noida on Republic coins; Pretoria on wartime British India issues." },
    { "id": "dot-in-diamond", "glyph": "◈", "label": "Dot in diamond", "mints": ["hyderabad"] },
    { "id": "split-diamond", "glyph": "◇", "label": "Split diamond", "mints": ["hyderabad"] },
    { "id": "B", "glyph": "B", "label": "Letter B", "mints": ["bombay"], "note": "B for Bombay." },
    { "id": "M", "glyph": "M", "label": "Letter M", "mints": ["mumbai"], "note": "M for Mumbai, used from 1996." },
    { "id": "L", "glyph": "L", "label": "Letter L", "mints": ["lahore"] },
    { "id": "H", "glyph": "H", "label": "Letter H", "mints": ["birmingham"] },
    { "id": "KN", "glyph": "KN", "label": "Letters KN", "mints": ["kings-norton"] }
  ],

  "_denominationsComment": "Pre-decimal ran until 1957: 12 pies = 1 anna, 16 annas = 1 rupee. Decimal from 1957: 100 paise = 1 rupee. 'values' are the usual issues, offered as suggestions rather than a restriction.",
  "denominations": {
    "pre-decimal": [
      { "unit": "pie", "label": "Pie", "values": [1, 2, 3] },
      { "unit": "pice", "label": "Pice", "values": [1, 2] },
      { "unit": "anna", "label": "Anna", "values": [0.25, 0.5, 1, 2, 4, 8] },
      { "unit": "rupee", "label": "Rupee", "values": [0.25, 0.5, 1] }
    ],
    "decimal": [
      { "unit": "naya-paisa", "label": "Naya Paisa", "values": [1, 2, 3, 5, 10, 20, 25, 50], "note": "Used 1957–1964, before the name shortened to 'paise'." },
      { "unit": "paise", "label": "Paise", "values": [1, 2, 3, 5, 10, 20, 25, 50] },
      { "unit": "rupee", "label": "Rupee", "values": [1, 2, 5, 10, 20] }
    ]
  },

